<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UNIQUBE - Generate CNC"
    Width="1760" Height="960"
    MinWidth="1120" MinHeight="660"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False"
    Background="#FFF1F2F5"
    FontFamily="Segoe UI"
    FontSize="12.5"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="HeaderBg" Color="#FF16171B"/>
        <SolidColorBrush x:Key="HeaderSurface" Color="#FF25282F"/>
        <SolidColorBrush x:Key="HeaderLine" Color="#FF3A3F4B"/>
        <SolidColorBrush x:Key="HeaderMuted" Color="#FF9AA1AD"/>
        <SolidColorBrush x:Key="Panel" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Subtle" Color="#FFF6F7F9"/>
        <SolidColorBrush x:Key="Line" Color="#FFDFE2E8"/>
        <SolidColorBrush x:Key="LineSoft" Color="#FFECEEF2"/>
        <SolidColorBrush x:Key="Text" Color="#FF111827"/>
        <SolidColorBrush x:Key="Muted" Color="#FF6B7280"/>
        <SolidColorBrush x:Key="Accent" Color="#FFF7902C"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FFFFA94D"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#FFD97B0C"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#FFFFF4E2"/>
        <SolidColorBrush x:Key="Navy" Color="#FF03061E"/>
        <SolidColorBrush x:Key="OnAccent" Color="#FF16171B"/>

        <FontFamily x:Key="Mono">Consolas</FontFamily>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HeaderCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HeaderMuted}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE1E4EA"/>
                                <Setter Property="Foreground" Value="#FF9CA3AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF1F2F5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFC5CAD3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF9CA3AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFEEF0F3"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource HeaderSurface}"
                                BorderBrush="{StaticResource HeaderLine}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View option chip -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF1F2F5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1F2937"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF1F2937"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text boxes -->
        <Style x:Key="HeaderTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFEEF0F3"/>
            <Setter Property="CaretBrush" Value="#FFEEF0F3"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource HeaderSurface}"
                                BorderBrush="{StaticResource HeaderLine}" BorderThickness="1"
                                CornerRadius="5" Padding="8,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="5" Padding="8,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eye button: shows a program in the viewer -->
        <Style x:Key="EyeButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,0,8,0"/>
            <Setter Property="Foreground" Value="#FF9CA3AF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="Show this program in the viewer"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <Grid Width="18" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M1,6 C3.4,2.2 6.2,0.8 9,0.8 C11.8,0.8 14.6,2.2 17,6 C14.6,9.8 11.8,11.2 9,11.2 C6.2,11.2 3.4,9.8 1,6 Z"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round"/>
                                <Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE7E9EE"/>
                    <Setter Property="Foreground" Value="#FF374151"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Panel / truss list -->
        <Style x:Key="UnitItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left"
                                           Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Subtle}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="UnitRow">
            <Grid Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding Checked, Mode=OneWay}"
                          VerticalAlignment="Center" Margin="12,0,9,0" Focusable="False"
                          ToolTip="Include in the export"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"
                         Foreground="{StaticResource Text}"/><Run Text="   "/><Run
                         Text="{Binding Members, Mode=OneWay}" FontSize="11.5"
                         Foreground="{StaticResource Muted}"/>
                </TextBlock>
                <Ellipse x:Name="Dot" Grid.Column="2" Width="8" Height="8" Margin="6,0,2,0"
                         Fill="Transparent" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Style="{StaticResource EyeButton}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ok">
                    <Setter TargetName="Dot" Property="Fill" Value="#FF16A34A"/>
                    <Setter TargetName="Dot" Property="ToolTip" Value="Program checks passed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="warning">
                    <Setter TargetName="Dot" Property="Fill" Value="#FFD97706"/>
                    <Setter TargetName="Dot" Property="ToolTip" Value="Program has warnings"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="error">
                    <Setter TargetName="Dot" Property="Fill" Value="#FFDC2626"/>
                    <Setter TargetName="Dot" Property="ToolTip" Value="Program has errors"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="failed">
                    <Setter TargetName="Dot" Property="Fill" Value="#FFDC2626"/>
                    <Setter TargetName="Dot" Property="ToolTip" Value="Program could not be built"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Value tables -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Subtle}"/>
            <Setter Property="Foreground" Value="#FF4B5563"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="GridHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="7,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Flag}" Value="warning">
                    <Setter Property="Background" Value="#FFFFF7E0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Flag}" Value="error">
                    <Setter Property="Background" Value="#FFFDE8E8"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Subtle}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFFFE2B5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValueGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="RowHeight" Value="25"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}"/>
            <Setter Property="CellStyle" Value="{StaticResource GridCell}"/>
            <Setter Property="RowStyle" Value="{StaticResource GridRow}"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Strong" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBg}" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="BrandLogo" Height="40" MaxWidth="120" Stretch="Uniform"
                           SnapsToDevicePixels="True" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Rectangle Width="1" Height="20" Fill="{StaticResource HeaderLine}" Margin="14,0"/>
                    <TextBlock Text="Generate CNC" Foreground="#FFFFFFFF"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Check each program before it is written"
                               Foreground="{StaticResource HeaderMuted}" Margin="14,2,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,22,0">
                    <TextBlock Text="JOB NAME" Style="{StaticResource HeaderCaption}"/>
                    <TextBox x:Name="JobBox" Width="230" Style="{StaticResource HeaderTextBox}"
                             ToolTip="Written to the DETAILS row of every program"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FOLDER" Style="{StaticResource HeaderCaption}"/>
                    <Border Background="{StaticResource HeaderSurface}"
                            BorderBrush="{StaticResource HeaderLine}" BorderThickness="1"
                            CornerRadius="5" Height="28" Padding="8,0" Margin="0,0,8,0">
                        <TextBlock x:Name="FolderText" Foreground="#FFEEF0F3" MaxWidth="330"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button x:Name="FolderButton" Content="Change..."
                            Style="{StaticResource HeaderButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shown when the Revit model has changed since the list was read -->
        <Border x:Name="ModelBar" Grid.Row="1" Background="#FFFFF4D6" BorderBrush="#FFF0D48A"
                BorderThickness="0,0,0,1" Padding="18,6" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="ModelBarButton" DockPanel.Dock="Right" Content="Re-read now"
                        Style="{StaticResource SecondaryButton}" Height="26" Margin="14,0,0,0"/>
                <TextBlock x:Name="ModelBarText" VerticalAlignment="Center" Foreground="#FF8A4B08"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ============================= Body ============================= -->
        <Grid Grid.Row="2" Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="460"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="340"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="690" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- Left: panels / trusses -->
            <Border Grid.Column="0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,11,12,8">
                        <TextBlock Text="PANELS / TRUSSES" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CheckedCount" HorizontalAlignment="Right"
                                   Foreground="{StaticResource Muted}" FontSize="11.5"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="12,0,12,10">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"/>
                        <TextBlock x:Name="SearchHint" Text="Search panels" Margin="10,0,0,0"
                                   Foreground="#FF9CA3AF" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,1">
                        <ListBox x:Name="UnitList" BorderThickness="0" Background="Transparent"
                                 ItemTemplate="{StaticResource UnitRow}"
                                 ItemContainerStyle="{StaticResource UnitItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"/>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="12,10,12,12">
                        <UniformGrid Rows="1" Columns="3">
                            <Button x:Name="CheckAllButton" Content="Check All"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="0"/>
                            <Button x:Name="UncheckAllButton" Content="Uncheck All"
                                    Style="{StaticResource SecondaryButton}" Margin="2,0" Padding="0"/>
                            <Button x:Name="ToggleAllButton" Content="Toggle All"
                                    Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Padding="0"/>
                        </UniformGrid>
                        <Button x:Name="VerifyButton" Content="Run checks on every program"
                                Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                ToolTip="Builds each program and marks it green, amber or red in the list"/>
                        <Button x:Name="RefreshButton" Content="Re-read panels from Revit"
                                Style="{StaticResource SecondaryButton}" Margin="0,6,0,0"
                                Visibility="Collapsed"
                                ToolTip="Reads the panels and trusses from the model again and rebuilds what is shown"/>
                        <TextBlock x:Name="VerifyText" Foreground="{StaticResource Muted}"
                                   FontSize="11.5" Margin="1,7,0,0" TextWrapping="Wrap"
                                   Text="Click the eye to see a program. Tick the ones to export."/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"
                          Focusable="False"/>

            <!-- Centre: viewer -->
            <Border Grid.Column="2" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock x:Name="ViewTitle" DockPanel.Dock="Left" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                            <TextBlock x:Name="ViewSubtitle" Margin="10,3,0,0"
                                       Foreground="{StaticResource Muted}" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="ToolingToggle" Content="Tooling" IsChecked="True"
                                          Style="{StaticResource Chip}"
                                          ToolTip="Show every machine operation at its station"/>
                            <ToggleButton x:Name="LabelsToggle" Content="Labels" IsChecked="True"
                                          Style="{StaticResource Chip}"/>
                            <ToggleButton x:Name="StationsToggle" Content="Stations"
                                          Style="{StaticResource Chip}"
                                          ToolTip="Write the station value beside each operation"/>
                            <ToggleButton x:Name="DimensionsToggle" Content="Dimensions" IsChecked="True"
                                          Style="{StaticResource Chip}"/>
                            <Rectangle Width="1" Height="18" Fill="{StaticResource Line}" Margin="4,0,10,0"/>
                            <Button x:Name="ZoomOutButton" Content="-" Width="28" Padding="0"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"
                                    ToolTip="Zoom out"/>
                            <Button x:Name="ZoomInButton" Content="+" Width="28" Padding="0"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"
                                    ToolTip="Zoom in"/>
                            <Button x:Name="FitButton" Content="Fit" Padding="12,0"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Fit the whole panel (double-click the drawing)"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="Viewport" Grid.Row="1" Background="#FFFFFFFF"
                            BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,1"
                            ClipToBounds="True" Cursor="Cross">
                        <Grid>
                            <Canvas x:Name="Scene" IsHitTestVisible="False"/>
                            <Canvas x:Name="Overlay" IsHitTestVisible="False">
                                <Border x:Name="HoverTip" Background="#F2111827" CornerRadius="4"
                                        Padding="7,4" Visibility="Collapsed">
                                    <TextBlock x:Name="HoverText" Foreground="#FFFFFFFF" FontSize="11.5"/>
                                </Border>
                            </Canvas>
                            <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                                       IsHitTestVisible="False"
                                       Text="Click the eye beside a panel to see its CNC program."/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="14,7,14,8" MinHeight="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel x:Name="LegendPanel" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Readout" Grid.Column="1" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Mono}" FontSize="11.5"
                                   Foreground="{StaticResource Muted}" Margin="12,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent"
                          Focusable="False"/>

            <!-- Right: CNC values -->
            <Border Grid.Column="4" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                <Grid Margin="14,12,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="110"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="90"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Program summary -->
                    <StackPanel Grid.Row="0">
                        <Grid>
                            <TextBlock Text="CNC PROGRAM" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="FileText" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource Mono}" FontSize="11.5"
                                       Foreground="{StaticResource Muted}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                        </Grid>
                        <UniformGrid Rows="1" Columns="4" Margin="0,9,0,0">
                            <StackPanel>
                                <TextBlock Text="COMPONENTS" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="MetricComponents" Style="{StaticResource MetricValue}" Text="-"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="OPERATIONS" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="MetricOperations" Style="{StaticResource MetricValue}" Text="-"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="CUT LENGTH mm" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="MetricLength" Style="{StaticResource MetricValue}" Text="-"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="OVERALL W x H mm" Style="{StaticResource Caption}"
                                           ToolTip="Outside size of the tracks or chords: their end points plus the flange width taken from the section name"/>
                                <TextBlock x:Name="MetricExtents" Style="{StaticResource MetricValue}" Text="-"/>
                            </StackPanel>
                        </UniformGrid>
                        <WrapPanel x:Name="OpTotals" Margin="0,9,0,0"/>
                        <Border x:Name="CheckBanner" CornerRadius="5" Padding="10,7" Margin="0,8,0,0"
                                Background="{StaticResource Subtle}">
                            <StackPanel>
                                <TextBlock x:Name="CheckTitle" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RevitCheckText" Foreground="#FF374151" FontSize="11.5"
                                           Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="ProblemScroll" MaxHeight="74" Margin="0,5,0,0"
                                              VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel x:Name="ProblemList"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Components -->
                    <Grid Grid.Row="1" Margin="0,13,0,6">
                        <TextBlock Text="COMPONENTS" Style="{StaticResource Caption}"/>
                        <TextBlock Text="values exactly as written to the CSV, in file order"
                                   HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{StaticResource Muted}"/>
                    </Grid>
                    <DataGrid x:Name="ComponentGrid" Grid.Row="2" Style="{StaticResource ValueGrid}"
                              FrozenColumnCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding N}" Width="34"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" MinWidth="96"
                                                ElementStyle="{StaticResource Strong}"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}"/>
                            <DataGridTextColumn Header="Orientation" Binding="{Binding Orient}"/>
                            <DataGridTextColumn Header="Length" Binding="{Binding Length}"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="X0" Binding="{Binding X0}"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="Y0" Binding="{Binding Y0}"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="X1" Binding="{Binding X1}"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="Y1" Binding="{Binding Y1}"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="Web" Binding="{Binding Web}"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty}"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="Ops" Binding="{Binding Ops}"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="Section" Binding="{Binding Section}"/>
                            <DataGridTextColumn Header="Revit cut length" Binding="{Binding RevitCut}"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="Difference" Binding="{Binding Delta}"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="Revit ID" Binding="{Binding RevitId}"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Selected member -->
                    <StackPanel Grid.Row="3" Margin="0,11,0,6">
                        <Grid>
                            <TextBlock Text="OPERATIONS OF THE SELECTED MEMBER"
                                       Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ZoomMemberButton" Content="Zoom to member"
                                        Style="{StaticResource SecondaryButton}" Height="24"
                                        FontSize="11.5" IsEnabled="False"/>
                                <Button x:Name="SelectRevitButton" Content="Select in Revit"
                                        Style="{StaticResource SecondaryButton}" Height="24"
                                        FontSize="11.5" IsEnabled="False" Margin="6,0,0,0"
                                        Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="MemberTitle" FontWeight="SemiBold" Margin="0,5,0,0"
                                   Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                                   Text="Click a member in the drawing or a row above"/>
                        <TextBlock x:Name="MemberRevit" Foreground="{StaticResource Muted}"
                                   FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <DataGrid x:Name="OperationGrid" Grid.Row="4" Style="{StaticResource ValueGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding N}" Width="34"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTemplateColumn Header="Operation" Width="*" MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                                       Fill="{Binding Color}" Margin="0,0,7,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Operation}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="92"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="To far end" Binding="{Binding ToEnd}" Width="92"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTextColumn Header="From previous" Binding="{Binding Step}" Width="104"
                                                ElementStyle="{StaticResource Num}"
                                                HeaderStyle="{StaticResource GridHeaderRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- The row itself -->
                    <StackPanel Grid.Row="5" Margin="0,11,0,0">
                        <TextBlock Text="CSV ROW" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="RowText" IsReadOnly="True" Height="52" Margin="0,6,0,0"
                                 FontFamily="{StaticResource Mono}" FontSize="11.5"
                                 Foreground="{StaticResource Text}" Background="{StaticResource Subtle}"
                                 BorderBrush="{StaticResource Line}" Padding="6,5"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Disabled"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================ Footer ============================ -->
        <Grid Grid.Row="3" Margin="14,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Height="32"
                        Padding="18,0" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="ExportButton" Content="Export checked" MinWidth="170"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- ========================= Export report ========================= -->
        <Grid x:Name="ReportOverlay" Grid.Row="0" Grid.RowSpan="4" Background="#8C111827"
              Visibility="Collapsed">
            <Border Background="{StaticResource Panel}" CornerRadius="8" Width="720" MaxHeight="620"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20,24,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.28"/>
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ReportDot" Width="11" Height="11" Fill="#FF15803D"
                                     VerticalAlignment="Center" Margin="0,1,10,0"/>
                            <TextBlock x:Name="ReportTitle" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}"/>
                        </StackPanel>
                        <TextBlock x:Name="ReportSummary" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Text}" LineHeight="19"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="ReportOpenButton" Content="Open folder" Height="32"
                                Padding="18,0" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button x:Name="ReportCloseButton" Content="Done" MinWidth="110"
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                    <TextBox x:Name="ReportDetails" IsReadOnly="True" Margin="0,14,0,0" MinHeight="120"
                             FontFamily="{StaticResource Mono}" FontSize="11.5"
                             Foreground="{StaticResource Text}" Background="{StaticResource Subtle}"
                             BorderBrush="{StaticResource Line}" Padding="10,8"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
