<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootPage"
    Background="#FFF4F5F7"
    FontFamily="Segoe UI"
    FontSize="12">
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5B6CFF"/>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand header -->
        <Border x:Name="HeaderBar"
                Grid.Row="0"
                Background="Transparent"
                Margin="0,0,0,12"
                Padding="2,0,2,10">
            <StackPanel>
                <Image x:Name="BrandLogo"
                       Height="36"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,8"/>
                <TextBlock x:Name="TitleText"
                           Text="Vibe Modeler"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FF1A1D23"/>
                <TextBlock x:Name="SubtitleText"
                           Text="Select in the view, then ask — selection is remembered"
                           FontSize="11"
                           Foreground="#FF6B7280"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Chat surface -->
        <Border x:Name="ChatSurface"
                Grid.Row="1"
                Background="#FFFFFFFF"
                BorderBrush="#FFE2E5EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">
            <ScrollViewer x:Name="MessageScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MessageList"/>
            </ScrollViewer>
        </Border>

        <!-- Undo bar (shown after model changes) -->
        <Border x:Name="UndoBar"
                Grid.Row="2"
                Margin="0,8,0,0"
                Background="#FFFFF8E8"
                BorderBrush="#FFF0D78C"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,6"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UndoHintText"
                           Text="Model changed — you can undo the last step"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#FF7A5C00"
                           Margin="4,0,8,0"/>
                <Button x:Name="UndoButton"
                        Grid.Column="1"
                        Content="Undo"
                        MinWidth="64"
                        Height="28"
                        Padding="12,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="undo_click"/>
            </Grid>
        </Border>

        <!-- Composer -->
        <Border x:Name="ComposerBar"
                Grid.Row="3"
                Margin="0,8,0,0"
                Background="#FFFFFFFF"
                BorderBrush="#FFE2E5EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PromptInput"
                         Grid.Column="0"
                         MinHeight="44"
                         MaxHeight="120"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Center"
                         Padding="10,8"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="13"
                         KeyDown="prompt_keydown"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Width="72"
                        Height="40"
                        Margin="8,0,0,0"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Foreground="White"
                        BorderThickness="0"
                        Click="send_click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBg"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="8"
                                    Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBg" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBg" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
