<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UNIQUBE — Prepare MEP Panels"
    Height="560" Width="520"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Select panels — group, copy framing to host, enable sync:"
                   Margin="0,0,0,6" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" x:Name="summary_text"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" Foreground="#555555"/>
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="panel_stack" Margin="6"/>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btn_all" Content="Select All"
                    Width="100" Height="28" Margin="4"
                    Click="select_all_click"/>
            <Button x:Name="btn_ok" Content="Run"
                    Width="100" Height="28" Margin="4"
                    IsDefault="True" Click="ok_click"/>
        </StackPanel>
    </Grid>
</Window>
