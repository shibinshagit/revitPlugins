<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UNIQUBE — CNC Export"
    Height="520" Width="400"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Select panels / trusses to export:"
                   Margin="0,0,0,8" FontWeight="Bold"/>
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="panel_stack" Margin="6"/>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btn_all" Content="Select All"
                    Width="100" Height="28" Margin="4"
                    Click="select_all_click"/>
            <Button x:Name="btn_ok" Content="Export"
                    Width="100" Height="28" Margin="4"
                    IsDefault="True" Click="ok_click"/>
        </StackPanel>
    </Grid>
</Window>
