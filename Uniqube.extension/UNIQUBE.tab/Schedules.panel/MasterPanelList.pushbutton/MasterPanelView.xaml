<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UNIQUBE - Master Panel List"
    Height="600" Width="820"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Master Panel List"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <DataGrid Grid.Row="1" x:Name="grid"
                  AutoGenerateColumns="True" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False"
                  GridLinesVisibility="All"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btn_download" Content="Download CSV"
                    Width="130" Height="28" Margin="4" Click="download_click"/>
            <Button x:Name="btn_goto" Content="Go to Schedule"
                    Width="130" Height="28" Margin="4" Click="goto_click"/>
            <Button x:Name="btn_close" Content="Close"
                    Width="90" Height="28" Margin="4" Click="close_click"/>
        </StackPanel>
    </Grid>
</Window>
